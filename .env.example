# Copy this file to .env and fill in real values. Never commit .env.

# ---- Django ----
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional: public contact address shown on the Contact page (leave empty to hide it)
CONTACT_EMAIL=

# ---- Database (XAMPP MariaDB 10.11) ----
DB_NAME=mytrust_db
DB_USER=mytrust_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- Demo data (python manage.py seed_demo) ----
# Password for the demo_* accounts. Leave empty: seed_demo generates a random one and fills it in.
DEMO_USER_PASSWORD=
